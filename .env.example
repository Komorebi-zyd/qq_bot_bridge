QQBOT_APP_ID=your-app-id
QQBOT_APP_SECRET=your-app-secret
BRIDGE_API_TOKEN=replace-with-random-secret-at-least-32-characters
# Optional PostgreSQL URI. Empty uses /data/bridge.sqlite3. Configure privately in the hosting panel.
# Example: postgresql://dbuser:YOUR_PASSWORD@db.example.com:5432/qqbridge?sslmode=require
BRIDGE_DATABASE_URL=
# Optional proactive deny list: comma-separated scene:chat_id. QQ controls send permissions.
BRIDGE_PROACTIVE_DENY=
# Total retained outgoing-upload quota in the named volume (bytes); upload TTL cleanup frees expired media.
BRIDGE_MAX_MEDIA_BYTES=268435456

# Exact Host header values (include port if present); add your HTTPS cloud domain. No wildcards.
BRIDGE_ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080,[::1]:8080
# Optional browser Origin allowlist, exact scheme + host + port; absent Origin is permitted.
BRIDGE_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://[::1]:8080

# HTTPS media direct links; leave empty for public hosts, or specify exact hostnames.
BRIDGE_MEDIA_URL_HOSTS=
# Reply windows in seconds and reservations per source message.
BRIDGE_REPLY_WINDOW_C2C=3600
BRIDGE_REPLY_WINDOW_GROUP=300
BRIDGE_REPLY_WINDOW_GUILD=300
BRIDGE_REPLY_WINDOW_DM=300
BRIDGE_MAX_REPLIES_C2C=4
BRIDGE_MAX_REPLIES_GROUP=5
BRIDGE_MAX_REPLIES_GUILD=5
BRIDGE_MAX_REPLIES_DM=5
